[options]
; ---------------------------------------------------------------------------
; Odoo 19.0 - local development configuration TEMPLATE
;
;   copy odoo.conf.example odoo.conf
;   then edit the credentials and paths below.
;
; Run with:  venv\Scripts\python.exe -m odoo -c odoo.conf
;        or: .\run-odoo.ps1
; ---------------------------------------------------------------------------

; --- Master password for the database manager at /web/database/manager ---
admin_passwd = CHANGE_ME

; --- PostgreSQL ---
; NOTE: db_user cannot be 'postgres' -- Odoo aborts on startup if it is,
; see check_postgres_user() in odoo/cli/server.py:37. Create a dedicated
; non-superuser role instead:
;   CREATE ROLE odoo LOGIN PASSWORD 'odoo' CREATEDB;
db_host = localhost
db_port = 5433
db_user = odoo
db_password = CHANGE_ME
db_name = odoo19
db_maxconn = 64

; --- Where modules are loaded from ---
; This source distribution keeps all 685 modules under odoo/addons.
; Append your own directory here (comma-separated) for custom modules.
addons_path = C:\path\to\odoo-19.0\odoo\addons,C:\path\to\odoo-19.0\custom_addons

; --- Filestore, sessions, compiled assets ---
; Real attachments live here. Back this up together with the database dump.
data_dir = C:\path\to\odoo-19.0\.odoo_data

; --- HTTP ---
http_interface = 127.0.0.1
http_port = 8069
gevent_port = 8072

; --- Process model ---
; Windows has no gevent/greenlet in requirements.txt, so multiprocessing
; is unavailable: workers must stay 0 (threaded server).
; On Linux, set workers = (cpu_cores * 2) + 1 and budget ~1 GB RAM each.
workers = 0
max_cron_threads = 2

; --- Wall-clock request watchdog ---
; MUST be 0 on Windows, where the default of 120s makes an idle server kill
; itself:
;
;   1. In the threaded server, thread.start_time is stamped once per TCP
;      *connection*, not per request (odoo/service/server.py:294).
;   2. A browser keeps its connection alive between requests, so the thread
;      sits in socket.recv_into() accruing wall-clock time with no request in
;      flight -- the give-away in the log is "(db:n/a) (uid:n/a) (url:n/a)".
;   3. Past limit_time_real the watchdog flags that thread and calls reload().
;   4. reload() is os.kill(pid, signal.SIGHUP), and on Windows Odoo shims
;      SIGHUP to -1 (server.py:40). os.kill(pid, -1) on Windows is
;      TerminateProcess, so the server does not reload -- it dies.
;
; On Linux the same watchdog works as intended, because SIGHUP is a real
; signal there and triggers a graceful reload. Restore the 120 default when
; deploying to Linux with workers > 0.
;
; limit_time_real_cron stays at its default of -1, meaning "follow
; limit_time_real", so cron threads are covered by this single setting.
limit_time_real = 0

; --- Logging ---
log_level = info
log_handler = :INFO

; --- Show the database selector / manager ---
; Set to False in any deployment reachable from outside localhost.
list_db = True

; --- Uncomment while developing addons: auto-reload on .py change,
;     no asset caching, better tracebacks ---
; dev_mode = reload,qweb,xml
