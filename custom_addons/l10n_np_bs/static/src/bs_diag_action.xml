<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_np_bs.DiagPlain">
        <div style="padding:2rem; font-size:1.2rem;">
            <h1 style="color:#714b67;">BS DIAG — PLAIN — OK</h1>
            <p>This action renders with no Layout wrapper.</p>
            <p t-esc="probe"/>
        </div>
    </t>

    <t t-name="l10n_np_bs.DiagLayout">
        <div class="o_action">
            <Layout display="display">
                <div style="padding:2rem; font-size:1.2rem;">
                    <h1 style="color:#714b67;">BS DIAG — LAYOUT — OK</h1>
                    <p>This action renders inside &lt;Layout&gt;.</p>
                    <p t-esc="probe"/>
                </div>
            </Layout>
        </div>
    </t>

</templates>
