<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_np_pos</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="55"/>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
                Anchored to the Payment block by id, which is core's
                (point_of_sale/views/res_config_settings_views.xml:75). The
                walk-in customer only ever matters at invoice time, so this is
                the section a shop owner is already in when they hit the
                refusal.

                UPG-3's lesson applies: an xpath that misses raises ParseError
                and takes the whole module's install with it. position="inside"
                on a block this module depends on is the safer of the available
                anchors, and the block carries an explicit id rather than being
                found by position.
            -->
            <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting id="np_pos_walk_in_customer"
                         string="Walk-in Customer"
                         help="Invoice customer used when a cashier issues an invoice without selecting one. Leave empty to refuse those invoices instead.">
                    <field name="pos_np_pos_default_partner_id"
                           options="{'no_create_edit': True}"/>
                    <div class="text-muted mt-1">
                        A plain cash receipt records no customer at all; this is
                        substituted only when an invoice is requested. An invoice
                        with no customer cannot be reconciled against its
                        payment, so it would post as unpaid.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
