<?xml version="1.0" encoding="utf-8"?>
<!--
  Multi-company record rules (SEC-2). See l10n_np_loan's equivalent file for why
  these are global and not noupdate.

  A filed VAT return is the most sensitive record in this repo: SEC-2's concern is
  that company A's accountant could read, and with the ACLs as written also
  rewrite, company B's filed return.

  l10n_np.vat.return.box and l10n_np.vat.return.line had no company_id at all, so
  the finding's premise that a rule could simply be added was wrong for these two.
  Each now carries a stored related company_id, taken from the owning form version
  and filed return respectively, purely so there is a column to filter on.

  The same 'in' versus 'parent_of' question applies to the form definition as to
  TDS categories, and is resolved the same way and for the same reason.
-->
<odoo>
    <record id="l10n_np_vat_return_form_company_rule" model="ir.rule">
        <field name="name">VAT return form version multi-company</field>
        <field name="model_id" ref="model_l10n_np_vat_return_form"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_np_vat_return_box_company_rule" model="ir.rule">
        <field name="name">VAT return box multi-company</field>
        <field name="model_id" ref="model_l10n_np_vat_return_box"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_np_vat_return_company_rule" model="ir.rule">
        <field name="name">VAT return multi-company</field>
        <field name="model_id" ref="model_l10n_np_vat_return"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_np_vat_return_line_company_rule" model="ir.rule">
        <field name="name">VAT return line multi-company</field>
        <field name="model_id" ref="model_l10n_np_vat_return_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
