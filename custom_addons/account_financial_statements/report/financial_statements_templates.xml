<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shared: one section with its account blocks.

         Drill-down here is attributes, not JavaScript. Odoo core wraps any element
         carrying res-id + res-model + view-type in a link
         (web/static/src/webclient/actions/reports/report_hook.js:47, applied at
         report_action.js:37), and an element carrying res-model + domain opens a
         filtered list. Both are inert when this same template renders to PDF,
         which is the reason screen and paper cannot drift apart: there is one
         template, not two.

         The collapse markers are structural rather than numbered. An earlier
         attempt used the QWeb foreach index, but this template is called once per
         section, so those indices restart and collide across sections. The
         toggling script instead walks forward from a header row over the rows
         marked as its lines. -->
    <template id="section_block">
        <t t-foreach="section['blocks']" t-as="block">
            <tr class="afs-block" data-afs-block="1">
                <td colspan="2" style="padding-left:12px;">
                    <span class="afs-toggle d-print-none">&#9662;</span>
                    <i t-esc="block['label']"/>
                </td>
                <td/>
            </tr>
            <tr t-foreach="block['lines']" t-as="line" data-afs-line="1">
                <td style="padding-left:32px;">
                    <span t-att-res-id="line['account_id']" res-model="account.account"
                          view-type="form" t-esc="line['code']"/>
                </td>
                <td t-esc="line['name']"/>
                <td class="text-end">
                    <span t-att-domain="line['domain']" res-model="account.move.line"
                          t-esc="line['amount']"
                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                </td>
            </tr>
            <tr data-afs-subtotal="1">
                <td colspan="2" style="padding-left:12px;" class="text-muted">
                    <small>Subtotal <t t-esc="block['label']"/></small>
                </td>
                <td class="text-end text-muted" style="border-top:1px solid #ddd;">
                    <small><span t-att-domain="block['domain']" res-model="account.move.line"
                          t-esc="block['subtotal']"
                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/></small>
                </td>
            </tr>
        </t>
    </template>

    <!-- Shared: what looks wrong, and a way into it.

         Rendered server-side on purpose so it prints. A caveat you can see while
         reading on screen but which is missing from the copy that gets filed is
         worse than no caveat at all, because the filed copy is the one someone
         relies on months later. Each row is itself a drill-down. -->
    <template id="anomaly_panel">
        <div t-if="anomalies" class="mt-3">
            <t t-foreach="anomalies" t-as="anomaly">
                <div t-attf-class="alert alert-{{anomaly['level']}} py-2 mb-2" role="alert">
                    <span t-esc="anomaly['message']"/>
                    <span t-if="anomaly['domain']" class="ms-1">
                        <span t-att-domain="anomaly['domain']" res-model="account.move.line">
                            <small>Show the entries</small>
                        </span>
                    </span>
                </div>
            </t>
        </div>
    </template>

    <!-- Shared: says once what would otherwise need saying on every credit line. -->
    <template id="drilldown_legend">
        <p class="text-muted mt-2"><small>
            Account codes and amounts are links: a code opens the account, an amount
            opens the journal items behind it. For liabilities, equity and income the
            journal-item list totals the negation of the figure shown, because Odoo
            stores credit balances as negative and this report presents them the way
            an accountant reads them.
        </small></p>
    </template>

    <!-- ============================ BALANCE SHEET ============================ -->
    <template id="balance_sheet">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2 class="mb-0">Balance Sheet</h2>
                    <p class="text-muted">
                        <span t-field="wizard.company_id.name"/> &#8212;
                        as at <span t-field="wizard.date_to"/><br/>
                        <small>
                            Fiscal year <span t-esc="fy_from"/> to <span t-esc="fy_to"/>
                            &#183; <span t-field="wizard.target_move"/>
                        </small>
                    </p>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th style="width:12%;">Code</th>
                                <th>Account</th>
                                <th class="text-end" style="width:22%;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="3"><b>ASSETS</b></td></tr>
                            <t t-call="account_financial_statements.section_block">
                                <t t-set="section" t-value="assets"/>
                            </t>
                            <tr style="border-top:2px solid #333;">
                                <td colspan="2"><b>TOTAL ASSETS</b></td>
                                <td class="text-end"><b>
                                    <span t-att-domain="assets['domain']" res-model="account.move.line"
                                          t-esc="assets['total']"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>

                            <tr><td colspan="3" style="padding-top:14px;"><b>LIABILITIES</b></td></tr>
                            <t t-call="account_financial_statements.section_block">
                                <t t-set="section" t-value="liabilities"/>
                            </t>
                            <tr>
                                <td colspan="2"><b>Total Liabilities</b></td>
                                <td class="text-end"><b>
                                    <span t-att-domain="liabilities['domain']" res-model="account.move.line"
                                          t-esc="liabilities['total']"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>

                            <tr><td colspan="3" style="padding-top:14px;"><b>EQUITY</b></td></tr>
                            <t t-call="account_financial_statements.section_block">
                                <t t-set="section" t-value="equity"/>
                            </t>
                            <!--
                                Prior years' profit, which Community never closes
                                into equity. Rendered only when non-zero: on a
                                first-year sheet the line would always read zero,
                                and a permanent zero row trains the reader to stop
                                looking at it. See ACC-2.
                            -->
                            <tr t-if="not wizard.company_id.currency_id.is_zero(unallocated)">
                                <td colspan="2" style="padding-left:12px;"><i t-esc="unallocated_label"/></td>
                                <td class="text-end">
                                    <span t-att-domain="unallocated_domain" res-model="account.move.line"
                                          t-esc="unallocated"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" style="padding-left:12px;"><i t-esc="result_label"/></td>
                                <td class="text-end">
                                    <span t-att-domain="result_domain" res-model="account.move.line"
                                          t-esc="result"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2"><b>Total Equity</b></td>
                                <td class="text-end"><b>
                                    <span t-esc="total_equity"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>

                            <tr style="border-top:2px solid #333;">
                                <td colspan="2"><b>TOTAL LIABILITIES AND EQUITY</b></td>
                                <td class="text-end"><b>
                                    <span t-esc="total_liab_equity"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>
                        </tbody>
                    </table>

                    <div t-if="balanced" class="alert alert-success py-2">
                        Balanced: assets equal liabilities plus equity.
                    </div>
                    <!-- The out-of-balance case is deliberately NOT repeated here.
                         It is the first entry in the anomaly panel below, which says
                         the same thing and adds a way into the entries. Saying it
                         twice trains people to skip both. -->

                    <t t-call="account_financial_statements.anomaly_panel"/>
                    <t t-call="account_financial_statements.drilldown_legend"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================ PROFIT AND LOSS ============================ -->
    <template id="profit_loss">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2 class="mb-0">Profit and Loss</h2>
                    <p class="text-muted">
                        <span t-field="wizard.company_id.name"/> &#8212;
                        <span t-field="wizard.date_from"/> to <span t-field="wizard.date_to"/><br/>
                        <small t-field="wizard.target_move"/>
                    </p>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th style="width:12%;">Code</th>
                                <th>Account</th>
                                <th class="text-end" style="width:22%;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="3"><b>INCOME</b></td></tr>
                            <t t-call="account_financial_statements.section_block">
                                <t t-set="section" t-value="income"/>
                            </t>
                            <tr>
                                <td colspan="2"><b>Total Income</b></td>
                                <td class="text-end"><b>
                                    <span t-att-domain="income['domain']" res-model="account.move.line"
                                          t-esc="income['total']"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>

                            <tr><td colspan="3" style="padding-top:14px;"><b>COST OF SALES</b></td></tr>
                            <t t-call="account_financial_statements.section_block">
                                <t t-set="section" t-value="cost_of_sales"/>
                            </t>
                            <tr style="border-top:2px solid #333;">
                                <td colspan="2"><b>GROSS PROFIT</b></td>
                                <td class="text-end"><b>
                                    <span t-esc="gross"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>

                            <tr><td colspan="3" style="padding-top:14px;"><b>OPERATING EXPENSES</b></td></tr>
                            <t t-call="account_financial_statements.section_block">
                                <t t-set="section" t-value="expenses"/>
                            </t>
                            <tr>
                                <td colspan="2"><b>Total Expenses</b></td>
                                <td class="text-end"><b>
                                    <span t-att-domain="expenses['domain']" res-model="account.move.line"
                                          t-esc="expenses['total']"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>

                            <tr style="border-top:2px solid #333;">
                                <td colspan="2"><b>NET PROFIT</b></td>
                                <td class="text-end"><b>
                                    <span t-att-domain="net_domain" res-model="account.move.line"
                                          t-esc="net"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- GROSS PROFIT carries no link on purpose: it is income minus
                         cost of sales, two sections with opposite signs, so no single
                         domain sums to it. A link that opened "roughly these lines"
                         would be worse than none. -->

                    <t t-call="account_financial_statements.anomaly_panel"/>
                    <t t-call="account_financial_statements.drilldown_legend"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================ ACTIONS ============================

         Each statement has TWO action records sharing one report_name: the
         qweb-html one the wizard opens, and a qweb-pdf twin. That pairing is what
         makes the report viewer's own Print button work, because it fires the pdf
         variant of the report_name it is displaying (report_action.js:45-54). So
         printing needs no code of ours. It is also why the drill-down attributes
         had to be inert in PDF: both variants render the SAME template, so the
         paper copy and the screen copy cannot disagree.

         The report_name must stay equal to the AbstractModel name without its
         'report.' prefix; test_the_values_model_name_matches_the_report_name
         fails loudly otherwise. -->
    <record id="action_report_balance_sheet" model="ir.actions.report">
        <field name="name">Balance Sheet</field>
        <field name="model">account.financial.statements.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">account_financial_statements.balance_sheet</field>
        <field name="report_file">account_financial_statements.balance_sheet</field>
    </record>

    <record id="action_report_balance_sheet_pdf" model="ir.actions.report">
        <field name="name">Balance Sheet</field>
        <field name="model">account.financial.statements.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_statements.balance_sheet</field>
        <field name="report_file">account_financial_statements.balance_sheet</field>
    </record>

    <record id="action_report_profit_loss" model="ir.actions.report">
        <field name="name">Profit and Loss</field>
        <field name="model">account.financial.statements.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">account_financial_statements.profit_loss</field>
        <field name="report_file">account_financial_statements.profit_loss</field>
    </record>

    <record id="action_report_profit_loss_pdf" model="ir.actions.report">
        <field name="name">Profit and Loss</field>
        <field name="model">account.financial.statements.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_statements.profit_loss</field>
        <field name="report_file">account_financial_statements.profit_loss</field>
    </record>


    <!-- ============================ CASH FLOW ============================ -->
    <template id="cash_flow">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2 class="mb-0">Cash Flow Statement</h2>
                    <p class="text-muted">
                        <span t-field="wizard.company_id.name"/> &#8212;
                        <span t-field="wizard.date_from"/> to <span t-field="wizard.date_to"/><br/>
                        <small t-field="wizard.target_move"/>
                    </p>

                    <table class="table table-sm">
                        <thead>
                            <tr><th>Item</th><th class="text-end" style="width:24%;">Amount</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><b>Cash at beginning of period</b></td>
                                <td class="text-end"><b>
                                    <span t-att-domain="opening_domain" res-model="account.move.line"
                                          t-esc="opening"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>

                            <t t-foreach="sections" t-as="section">
                                <t t-if="section['lines']">
                                    <tr class="afs-block" data-afs-block="1">
                                        <td colspan="2" style="padding-top:12px;">
                                            <span class="afs-toggle d-print-none">&#9662;</span>
                                            <b t-esc="section['label']"/>
                                        </td>
                                    </tr>
                                    <tr t-foreach="section['lines']" t-as="line" data-afs-line="1">
                                        <td style="padding-left:28px;">
                                            <span t-if="line['account_id']"
                                                  t-att-res-id="line['account_id']"
                                                  res-model="account.account" view-type="form"
                                                  t-esc="line['label']"/>
                                            <span t-else="" t-esc="line['label']"/>
                                        </td>
                                        <td class="text-end">
                                            <!-- Links to the CONTRIBUTING entries, which is a weaker
                                                 claim than everywhere else in this module and is
                                                 labelled as such in the note below the table. The
                                                 amount is a pro-rata share of a cash movement, so it
                                                 is not the sum of any field on these records. -->
                                            <span t-att-domain="line['contributor_domain']"
                                                  t-att-res-model="line['contributor_domain'] and 'account.move.line' or None"
                                                  t-esc="line['amount']"
                                                  t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding-left:12px;"><i>Net cash from <t t-esc="section['label']"/></i></td>
                                        <td class="text-end" style="border-top:1px solid #ddd;">
                                            <span t-esc="section['total']"
                                                  t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>

                            <tr style="border-top:2px solid #333;">
                                <td><b>Net increase / decrease in cash</b></td>
                                <td class="text-end"><b>
                                    <span t-esc="net_change"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>
                            <tr>
                                <td><b>Cash at end of period</b></td>
                                <td class="text-end"><b>
                                    <span t-att-domain="closing_domain" res-model="account.move.line"
                                          t-esc="closing"
                                          t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                </b></td>
                            </tr>
                        </tbody>
                    </table>

                    <div t-if="reconciled" class="alert alert-success py-2">
                        Reconciled: classified movements equal the change in cash.
                    </div>
                    <!-- The unreconciled case is the anomaly panel's first entry, so
                         it is not also stated here. -->

                    <t t-call="account_financial_statements.anomaly_panel"/>

                    <p class="text-muted mt-2"><small>
                        Opening and closing cash are plain totals, so their links open
                        exactly the entries behind them. The activity lines are
                        different: each amount is a share of a cash movement
                        apportioned across the counterpart accounts of its entry, so it
                        is not the sum of any field on any record. Their links open the
                        entries that <i>contributed</i> to the figure, and the total of
                        that list will not equal the figure shown.
                    </small></p>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_cash_flow" model="ir.actions.report">
        <field name="name">Cash Flow Statement</field>
        <field name="model">account.financial.statements.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">account_financial_statements.cash_flow</field>
        <field name="report_file">account_financial_statements.cash_flow</field>
    </record>

    <record id="action_report_cash_flow_pdf" model="ir.actions.report">
        <field name="name">Cash Flow Statement</field>
        <field name="model">account.financial.statements.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_statements.cash_flow</field>
        <field name="report_file">account_financial_statements.cash_flow</field>
    </record>
</odoo>
