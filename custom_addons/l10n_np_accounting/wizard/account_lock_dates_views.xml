<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_lock_dates_form" model="ir.ui.view">
        <field name="name">account.lock.dates.form</field>
        <field name="model">account.lock.dates</field>
        <field name="arch" type="xml">
            <form string="Lock Dates">
                <group>
                    <field name="company_id" options="{'no_create': True}"/>
                </group>
                <group string="Soft locks (an Adviser may still grant an exception)">
                    <field name="fiscalyear_lock_date"/>
                    <field name="tax_lock_date"/>
                    <field name="sale_lock_date"/>
                    <field name="purchase_lock_date"/>
                </group>
                <group string="Hard lock (irreversible)">
                    <field name="hard_lock_date"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    The Hard Lock Date can only ever be moved forward. Once saved it
                    cannot be cleared or pulled back, and no exception can be granted
                    against it. Set it only after the period has been finalised.
                </div>
                <footer>
                    <button name="action_apply" string="Apply"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_lock_dates" model="ir.actions.act_window">
        <field name="name">Lock Dates</field>
        <field name="res_model">account.lock.dates</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
