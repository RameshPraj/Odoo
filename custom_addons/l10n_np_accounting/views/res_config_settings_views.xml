<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_np_accounting</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50"/>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='analytic']" position="before">
                <block title="Nepal" id="l10n_np_accounting"
                       groups="account.group_account_readonly">
                    <setting id="l10n_np_bs_accounting_dates"
                             string="Bikram Sambat dates"
                             help="Enter and read accounting dates in the Nepali calendar">
                        <field name="group_l10n_np_bs_accounting_dates"/>
                        <div class="content-group mt-2"
                             invisible="not group_l10n_np_bs_accounting_dates">
                            <div class="row">
                                <label for="l10n_np_bs_digits" class="col-lg-4 o_light_label"/>
                                <field name="l10n_np_bs_digits"/>
                            </div>
                            <div class="text-muted mt-2">
                                Dates remain stored as Gregorian, so reports, filters and
                                reconciliation are unaffected. Browse the calendar itself
                                under <b>Accounting Nepal &gt; Nepali Calendar</b>.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
