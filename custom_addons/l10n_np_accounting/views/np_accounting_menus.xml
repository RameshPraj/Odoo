<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Full "Accounting Nepal" application tree, mirroring the structure of the
        Enterprise Accounting app but built entirely from Community, OCA and local
        actions.

        Every action referenced here already exists; this file only arranges them.
        Nothing is duplicated: the same act_window can be reached from Odoo's own
        Invoicing menu as well.

        Items the Enterprise app has that are NOT reachable here, because no
        Community or OCA implementation exists, are listed in README.md rather
        than shown as dead menu entries.

        NB: never put a double hyphen inside an XML comment. It is illegal XML and
        invalidates the whole file, which in Odoo can blank the entire web client.
        Use "=" for separators.
    -->

    <menuitem id="menu_np_accounting_root"
              name="Accounting Nepal"
              web_icon="l10n_np_accounting,static/description/icon.png"
              sequence="11"/>

    <!-- ================================================================
         CUSTOMERS
         ================================================================ -->
    <menuitem id="menu_np_customers" name="Customers"
              parent="menu_np_accounting_root" sequence="10"/>

    <menuitem id="menu_np_cust_invoices" name="Invoices"
              parent="menu_np_customers" action="account.action_move_out_invoice_type"
              sequence="10"/>
    <menuitem id="menu_np_cust_credit_notes" name="Credit Notes"
              parent="menu_np_customers" action="account.action_move_out_refund_type"
              sequence="20"/>
    <menuitem id="menu_np_cust_payments" name="Payments"
              parent="menu_np_customers" action="account.action_account_payments"
              sequence="30"/>
    <menuitem id="menu_np_cust_products" name="Products"
              parent="menu_np_customers" action="account.product_product_action_sellable"
              sequence="40"/>
    <menuitem id="menu_np_cust_partners" name="Customers"
              parent="menu_np_customers" action="account.res_partner_action_customer"
              sequence="50"/>

    <!-- ================================================================
         VENDORS
         ================================================================ -->
