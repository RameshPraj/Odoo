              sequence="10"/>
    <menuitem id="menu_np_rep_tds_cert" name="TDS Certificates"
              parent="menu_np_rep_tax" action="l10n_np_tds.action_tds_certificate"
              sequence="20"/>

    <menuitem id="menu_np_rep_management" name="Management"
              parent="menu_np_reporting" sequence="50"/>
    <menuitem id="menu_np_rep_invoice_analysis" name="Invoice Analysis"
              parent="menu_np_rep_management" action="account.action_account_invoice_report_all"
              sequence="10"/>
    <menuitem id="menu_np_rep_bills_analysis" name="Bills Analysis"
              parent="menu_np_rep_management"
              action="account.action_account_invoice_report_all_supp" sequence="20"/>
    <menuitem id="menu_np_rep_analytic" name="Analytic Report"
              parent="menu_np_rep_management" action="account.action_analytic_reporting"
              groups="analytic.group_analytic_accounting" sequence="30"/>
    <menuitem id="menu_np_rep_budgets" name="Budgets"
              parent="menu_np_rep_management"
              action="account_budget_oca.act_crossovered_budget_view" sequence="40"/>

    <!-- ================================================================
         NEPALI CALENDAR
         ================================================================ -->
