<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Community has no button that calls account.move.line.reconcile().
         Add one to the Journal Items list. -->
    <record id="view_move_line_tree_reconcile" model="ir.ui.view">
        <field name="name">account.move.line.list.reconcile</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list[@name='move_line_tree']" position="inside">
                <header>
                    <button name="action_reconcile_selected" type="object"
                            string="Reconcile" class="btn-primary"
                            groups="account.group_account_user"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="action_account_reconcile" model="ir.actions.act_window">
        <field name="name">Reconcile</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <!-- Open items only: posted, still carrying a residual, on an account
             flagged 'Allow Reconciliation'. Grouped by account because
             reconcile() requires a single account. -->
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')),
                              ('account_id.reconcile', '=', True),
                              ('parent_state', '=', 'posted'),
                              ('amount_residual', '!=', 0)]</field>
        <field name="context">{'search_default_group_by_account': 1, 'expand': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing left to reconcile</p>
            <p>
                Every posted item on a reconcilable account is fully matched.
                To reconcile, select two or more items on the <b>same account</b>
                whose debits and credits offset, then press <b>Reconcile</b>.
            </p>
        </field>
    </record>

</odoo>
