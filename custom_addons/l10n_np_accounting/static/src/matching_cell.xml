<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="l10n_np_accounting.MatchingCell">
        <!--
            One element, two shapes. A clickable state renders an anchor so it
            gets keyboard focus and the pointer cursor for free; the rest render a
            span, because a link that does nothing is worse than plain text.

            The glyph is separated from the label by a real space rather than CSS,
            so a copy-paste out of the list keeps its meaning.
        -->
        <a t-if="isClickable"
           href="#"
           t-att-class="style.className"
           t-att-title="title"
           t-on-click="onClick">
            <span t-esc="style.glyph"/>
            <t t-esc="' '"/>
            <span t-esc="label"/>
        </a>

        <span t-else=""
              t-att-class="style.className"
              t-att-title="title">
            <span t-esc="style.glyph"/>
            <t t-if="label">
                <t t-esc="' '"/>
                <span t-esc="label"/>
            </t>
        </span>
    </t>

</templates>
