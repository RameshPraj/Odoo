<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Presentation-only group: when held, accounting date fields render and
        accept input in Bikram Sambat. Granted by the "Bikram Sambat accounting
        dates" checkbox in Accounting Settings, via `implied_group` on the
        `group_l10n_np_bs_accounting_dates` settings field.

        It is a group rather than a company field so that the arch cache can key
        on it, and so a Nepali accountant and an expatriate controller can each
        see the calendar they read fluently in the same database.
    -->
    <record id="group_bs_accounting_dates" model="res.groups">
        <field name="name">Bikram Sambat accounting dates</field>
        <field name="comment">Show and accept accounting dates in Bikram Sambat. Storage stays Gregorian.</field>
    </record>
</odoo>
